<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/plats.css">
     <link rel="stylesheet" href="/css/style.css">
    <title> Nos plats</title>
</head>
<body>
    


    <!--navbar le menu de navigation-->

    <%- include('navbar')-%>

   <h1>Nos plats</h1>

<!-- affichage des plats -->
<% resultatPlats.forEach(plat => { %>

  <div class="card">
    <!-- Photo du plat -->
    <% if (plat.photo) { %>
      <img src="pilao.avif" alt="<%= plat.nom %>" class="card-img">
    <% } else { %>
      <img src="/images/default-plat.jpg" alt="Photo non disponible" class="card-img">
    <% } %>

    <h3><%= plat.nom %></h3>
    <p><%= plat.description %></p>
    <p><%= plat.prix %> €</p>
    <p><%= plat.combien %></p>
    <p><%= plat.quantité %></p>
    <p><%= plat.ingrédient %></p>
    <p><%= plat.fait_maison %></p>
  </div>

<% }) %>





















</body>
<script src="/public/js/plats.js"></script>
</html>
