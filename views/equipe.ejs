<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon équipe</title>
    <link rel="stylesheet" href="/css/equipe.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>

<%- include('navbar') %>

<h2>Qui sont l'équipe May.gourmet ?</h2>

<!-- ✅ CONTENEUR AJOUTÉ -->
<div class="cards-container">

<% resultatEquipe.forEach(resultat => { %>
  <div class="card">

    <img src="/image/gerant.jpg" width="200" height="180">

    <div class="container">
      <b><%= resultat.prenom %></b> <%= resultat.nom %>
      <br>

      <!-- bouton contacter -->
      <button class="openModalBtn" 
        data-prenom="<%= resultat.prenom %>" 
        data-nom="<%= resultat.nom %>" 
        data-poste="<%= resultat.poste %>" 
        data-presentation="<%= resultat.presentation %>">
        Contacter
      </button>

    </div>

  </div>
<% }) %>

</div>

<!-- réseaux -->
<a href="#" class="fa fa-facebook"></a>
<a href="#" class="fa fa-twitter"></a>

<!-- bouton ajouter -->
<button id="myBtn">Ajouter un fournisseur !</button>

<!-- MODAL -->
<div id="myModal" class="modal">

  <div class="modal-content">

    <div class="modal-header">
      <span class="close">&times;</span>
      <h3>Ajouter un membre!</h3>
    </div>

    <div class="modal-body">
      <form action="/api/equipe" method="post">

        <input type="text" name="nomEquipe" placeholder="Nom" required><br><br>
        <input type="text" name="prenomEquipe" placeholder="Prénom" required><br><br>
        <input type="email" name="mailEquipe" placeholder="Email" required><br><br>
        <input type="text" name="telephoneEquipe" placeholder="Téléphone" required><br><br>
        <input type="text" name="adressePostaleEquipe" placeholder="Adresse" required><br><br>

        <button type="submit">Ajouter</button>

      </form>
    </div>

  </div>
</div>

<script src="/javascript/script.js"></script>
</body>
</html>