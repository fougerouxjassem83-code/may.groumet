<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon équipe</title>
    <link rel="stylesheet" href="/css/equipe.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>

<%- include('navbar') %>

<h2>Qui sont l'équipe May.gourmet ?</h2>

<div class="cards-container">

  <% resultatEquipe.forEach(resultat => { %>
    <div class="card">

      <img src="/image/gerant.jpg" width="200" height="180">

      <div class="container">
        <b><%= resultat.prenom %></b> <%= resultat.nom %> - <i><%= resultat.poste %></i><br>
        <%= resultat.presentation %> | <%= resultat.date_revrutrment %> | <%= resultat.mail %> | <%= resultat.telephone %>
        <br><br>

        <button class="openModalBtn"
          data-id="<%= resultat.id %>"
          data-nom="<%= resultat.nom %>"
          data-prenom="<%= resultat.prenom %>"
          data-poste="<%= resultat.poste %>"
          data-mail="<%= resultat.mail %>"
          data-telephone="<%= resultat.telephone %>"
          data-presentation="<%= resultat.presentation %>"
          data-date_revrutrment="<%= resultat.date_revrutrment %>">
          Modifier
        </button>

        <form action="/api/equipe/<%= resultat.id %>?_method=DELETE" method="post" style="display:inline;">
          <button type="submit">Supprimer</button>
        </form>

      </div>
    </div>
  <% }) %>

</div>

<!-- Réseaux -->
<a href="#" class="fa fa-facebook"></a>
<a href="#" class="fa fa-twitter"></a>
<a href="#" class="fa fa-instagram"></a>

<!-- Bouton ajouter -->
<button id="myBtn">Ajouter un membre !</button>

<!-- Modal Ajouter -->
<div id="myModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <span class="close">&times;</span>
      <h3>Ajouter un membre !</h3>
    </div>
    <div class="modal-body">
      <form action="/api/equipe" method="post">
        <input type="text"  name="nomEquipe"          placeholder="Nom"       required><br><br>
        <input type="text"  name="prenomEquipe"        placeholder="Prénom"    required><br><br>
        <input type="email" name="mailEquipe"          placeholder="Email"     required><br><br>
        <input type="text"  name="telephoneEquipe"     placeholder="Téléphone" required><br><br>
        <input type="text"  name="adressePostaleEquipe" placeholder="Adresse"  required><br><br>
        <button type="submit">Ajouter</button>
      </form>
    </div>
  </div>
</div>

<!-- Modal Modifier -->
<div id="myModal2" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <span class="close">&times;</span>
      <h3>Modifier un membre !</h3>
    </div>
    <div class="modal-body">
      <form id="form-modifier-membre">
        <input type="hidden" id="editId">
        <input type="text"  id="editNom"              placeholder="Nom"                  required><br><br>
        <input type="text"  id="editPrenom"            placeholder="Prénom"               required><br><br>
        <input type="email" id="editMail"              placeholder="Email"                required><br><br>
        <input type="text"  id="editTelephone"         placeholder="Téléphone"            required><br><br>
        <input type="text"  id="editPoste"             placeholder="Poste"                required><br><br>
        <input type="text"  id="editPresentation"      placeholder="Présentation"                 ><br><br>
        <input type="date"  id="editdate_revrutrment"  placeholder="Date de recrutement"  required><br><br>
        <button type="submit">Modifier</button>
      </form>
    </div>
  </div>
</div>

<!-- Script tout en bas, après le HTML -->
<script src="/javascript/script.js"></script>
</body>
</html>