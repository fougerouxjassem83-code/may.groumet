<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon équipe</title>
    <link rel="stylesheet" href="/css/equipe.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>

<!-- Navbar (menu de navigation) -->
<%- include('navbar') %>

<h2>Qui sont l'équipe May.gourmet ?</h2>

<!-- Boucle pour afficher chaque membre -->
<% resultatEquipe.forEach(resultat => { %>
  <div class="card">

    <!-- Image du membre -->
    <img src="/image/gerant.jpg" width="200" height="180">

    <div class="container">
      <!-- Nom + prénom -->
      <b><%= resultat.prenom %></b> <%= resultat.nom %>
      <br>

      <!-- Bouton pour contacter ce membre -->
<button class="openModalBtn" 
  data-prenom="<%= resultat.prenom %>" 
    data-nom="<%= resultat.nom %>" 
      data-poste="<%= resultat.poste %>" 
      data-presentation="<%= resultat.presentation %>">
      Contacter
    </button>
</div>

  </div>
<% }) %>

<!-- Liens réseaux sociaux -->
<a href="#" class="fa fa-facebook"></a>
<a href="#" class="fa fa-twitter"></a>



<!-- Bouton pour ouvrir la popup -->
<button id="myBtn">Ajouter un fournisseur !</button>

<!-- Fenêtre popup -->
<div id="myModal" class="modal">

  <!-- Contenu de la popup -->
  <div class="modal-content">
    
    <!-- En-tête -->
    <div class="modal-header">
      <span class="close">&times;</span>
      <h3>Ajouter un membre!</h3>
    </div>

    <!-- Corps (formulaire) -->
    <div class="modal-body">
  <form action="/api/equipe" method="post">

    <label>Nom :</label><br>
    <input type="text" name="nomEquipe" placeholder="votre nom ..." required><br><br>

    <label>Prenom :</label><br>
    <input type="text" name="prenomEquipe" placeholder="Prenom" required><br><br>

    <label>Email :</label><br>
    <input type="email" name="mailEquipe" placeholder="Email du membre" required><br><br>

    <label>Téléphone :</label><br>
    <input type="text" name="telephoneEquipe" placeholder="Téléphone" required><br><br>

    <label>Adresse :</label><br>
    <input type="text" name="adressePostaleEquipe" placeholder="Adresse" required><br><br>

    <button type="submit">Ajouter</button>
  </form>
</div>

    <!-- Bas de la popup -->
    <div class="modal-footer">
    </div>

  </div>
</div>

<!-- Script JS -->
<script src="/javascript/script.js"></script>
</body>
</html>